{
  "name": "windows-screenshot",
  "version": "0.3.5",
  "description": "Private, local Windows screenshot and annotation tool",
  "author": "Windows Screenshot",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/install-electron.cjs",
    "dev": "pnpm build:electron && node scripts/dev.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "pnpm typecheck && pnpm build:electron && vite build",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "dist": "pnpm build && electron-builder --win nsis --x64",
    "release": "bumpp -r"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "bumpp": "12.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "lucide-react": "1.43.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "zustand": "5.0.15"
  }
}
