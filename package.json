{
  "name": "windows-screenshot",
  "version": "0.3.10",
  "description": "Private, local Windows screenshot and annotation tool",
  "author": "Windows Screenshot",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "mygo dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "generate": "mygo generate",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && mygo build",
    "test": "vitest run && go test ./desktop",
    "release": "bumpp -r"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "bumpp": "12.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.43.0",
    "mygo-cli": "0.5.5",
    "mygo-runtime": "0.5.5",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "zustand": "5.0.15"
  }
}
